<node>
  <!-- M3: implemented by `walky daemon` on the session bus. -->
  <interface name="io.github.ijin.Walky1">
    <method name="SyncNow">
      <arg type="b" direction="in" name="wait"/>
    </method>
    <method name="Pause">
      <arg type="b" direction="in" name="paused"/>
    </method>
    <method name="GetStatus">
      <arg type="a{sv}" direction="out" name="status"/>
    </method>
    <method name="GetEvents">
      <arg type="u" direction="in" name="limit"/>
      <arg type="a(ssstt)" direction="out" name="events"/>
    </method>
    <method name="Eject"/>
    <method name="Verify">
      <arg type="b" direction="in" name="full"/>
    </method>

    <signal name="StateChanged">
      <arg type="s" name="state"/>
    </signal>
    <signal name="Progress">
      <arg type="u" name="done"/>
      <arg type="u" name="total"/>
      <arg type="t" name="bytes"/>
    </signal>
    <signal name="FileDone">
      <arg type="s" name="path"/>
      <arg type="s" name="op"/>
      <arg type="s" name="result"/>
    </signal>
  </interface>
</node>
