[Unit]
Description=Walky offline drive sync
Documentation=man:walky(1)
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
# The daemon owns io.github.ijin.Walky1 on the session bus; systemd considers
# the unit started once the name appears, and D-Bus activation starts it on
# demand.
Type=dbus
BusName=io.github.ijin.Walky1
ExecStart=/usr/bin/walky daemon
Restart=on-failure
RestartSec=3
Slice=background.slice
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes

[Install]
WantedBy=graphical-session.target
